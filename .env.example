# =====================================================================
# cuentas-venezuela — environment template
# Copy to .env for local dev. Production secrets live in:
#   - Cloudflare Pages env (web)
#   - Cloudflare Workers secrets   → wrangler secret put FOO  (or scripts/cf-worker-secrets.sh)
#   - GitHub Actions secrets (CI + ETL cron)
# =====================================================================

# ---- Postgres (dev = docker compose, prod = Neon) -------------------
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=datos
DATABASE_URL=postgres://dev:dev@postgres:5432/datos
# Host-side port mapping for Postgres (avoid conflicts with local Postgres)
POSTGRES_HOST_PORT=5433

# Prod Neon URL (do NOT commit, set via secret manager):
# DATABASE_URL=postgresql://USER:PASS@ep-xxxx.us-east-2.aws.neon.tech/datos?sslmode=require

# ---- S3-compatible storage (dev = MinIO, prod = Cloudflare R2) ------
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=datasets
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_FORCE_PATH_STYLE=true

# Prod R2 example:
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=cuentas-venezuela-prod
# S3_KEY=<R2_ACCESS_KEY_ID>
# S3_SECRET=<R2_SECRET_ACCESS_KEY>
# S3_FORCE_PATH_STYLE=true

# ---- API ------------------------------------------------------------
API_LOG_LEVEL=info
API_HOST_PORT=8100

# Comma-separated list of allowed CORS origins. Empty = reflect any origin
# (dev only). Set in prod to lock down the API.
# CORS_ORIGINS=https://cuentasvenezuela.org,https://www.cuentasvenezuela.org
CORS_ORIGINS=

# ---- Web (Next.js) --------------------------------------------------
# Browser-side API base URL. Empty string = same-origin via /api rewrite.
NEXT_PUBLIC_API_URL=http://localhost:8100
WEB_HOST_PORT=3100

# Server-side API URL used by Next rewrites (RSC + route handlers).
# Local: http://api:8000 (docker compose service name)
# Prod:  https://api.cuentasvenezuela.org (Cloudflare Workers route)
INTERNAL_API_URL=http://api:8000

# Public site URL — used in sitemap, OG tags, share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Prod: NEXT_PUBLIC_SITE_URL=https://cuentasvenezuela.org

# Public repo URL (shown on /apoyar)
NEXT_PUBLIC_REPO_URL=https://github.com/Mundo-Dev0ps/cuentas-venezuela

# ---- Cloudflare Turnstile (CAPTCHA for /api/reportes) ---------------
# Both keys from CF Dashboard → Turnstile → Add site
# Site key is public (browser-exposed); secret stays in Worker only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- MinIO host port mappings (dev only) ----------------------------
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101

# ---- Ko-fi integration (donations) ----------------------------------
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/donjonny
# From Ko-fi dashboard → Settings → API → Webhook → "Verification Token"
KOFI_VERIFICATION_TOKEN=

# ---- Observability --------------------------------------------------
# No external error tracker. Errors + per-request logs land in:
#   - Cloudflare Workers dashboard → Workers & Pages → cuentas-venezuela-api → Logs
#   - Cloudflare Pages dashboard  → cuentas-venezuela → Functions → Logs
# Both are free, included with the Cloudflare account, zero SDK overhead.
# Live tailing: `npx wrangler tail` from api/
