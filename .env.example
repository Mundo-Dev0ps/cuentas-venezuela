# Postgres (dev relational DB)
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=datos
DATABASE_URL=postgres://dev:dev@postgres:5432/datos
# Host-side port mapping for Postgres (avoid conflicts with local instance)
POSTGRES_HOST_PORT=5433

# S3-compatible storage (MinIO local, R2 in prod)
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=datasets
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_FORCE_PATH_STYLE=true

# API
API_LOG_LEVEL=info
API_HOST_PORT=8100

# Web
NEXT_PUBLIC_API_URL=http://localhost:8100
WEB_HOST_PORT=3100

# MinIO host port mappings
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
